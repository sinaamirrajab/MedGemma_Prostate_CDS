# Frontend
# Project root used by src/data/patientCsv.js to convert absolute paths to root-relative URLs.
VITE_PROJECT_ROOT=/mnt/data9/projects/medgemma_challenge_UI/cds

# Additional root-relative conversion for viewer paths (optional).
VITE_ADDITIONAL_VIEWER_ROOT=

# Colon-separated filesystem roots allowed by Vite /@fs during dev.
VITE_ALLOWED_FILE_ROOTS=/mnt/data9/projects/medgemma_challenge_UI/cds:/mnt/data9/projects/medgemma_challenge_UI/cds/imgs

# API targets (dev proxy)
VITE_MEDGEMMA_API_TARGET=http://127.0.0.1:8000
VITE_CLASSIFIER_API_TARGET=http://127.0.0.1:8001

# Backend classifier
# Colon-separated list of allowed file roots for request file paths.
CLASSIFIER_ALLOWED_ROOTS=/mnt/data9/projects/medgemma_challenge_UI/cds:/tmp
